<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fonstela | Links Oficiais</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #080808, #191323, #080808);
    color: white;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px;
}

.container {
    width: 100%;
    max-width: 400px;
    text-align: center;
}

.avatar {
    width: 110px;
    height: 110px;
    margin: auto auto 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #9333ea, #ec4899);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    font-weight: bold;
    box-shadow: 0 0 35px #9333ea55;
}

h1 {
    font-size: 30px;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.description {
    color: #bdb7c9;
    margin-bottom: 30px;
    line-height: 1.6;
}

.link {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: white;
    background: #ffffff0b;
    border: 1px solid #ffffff20;
    padding: 17px;
    border-radius: 15px;
    margin-bottom: 13px;
    transition: 0.25s;
}

.link:hover {
    transform: translateY(-4px);
    background: #9333ea30;
    border-color: #a855f7;
}

.emoji {
    font-size: 28px;
    width: 40px;
}

.info {
    flex: 1;
    text-align: left;
}

.info h2 {
    font-size: 16px;
    margin-bottom: 5px;
}

.info p {
    font-size: 12px;
    color: #aaa;
}

.arrow {
    font-size: 23px;
    color: #c084fc;
}

footer {
    color: #777;
    font-size: 12px;
    margin-top: 25px;
}
</style>
</head>

<body>

<div class="container">

    <div class="avatar">F</div>

    <h1>MAGRELO</h1>

    <p class="description">
        Bem-vindo ao meu mundo! ✨<br>
        Encontra aqui todas as minhas redes sociais.
    </p>

    <a class="link"
       href="https://www.instagram.com/magrelo.yt/"
       target="_blank" rel="noopener noreferrer">
        <span class="emoji">📸</span>
        <div class="info">
            <h2>Instagram</h2>
            <p>Segue o meu perfil</p>
        </div>
        <span class="arrow">↗</span>
    </a>

    <a class="link"
       href="https://www.tiktok.com/@magrelo.yt"
       target="_blank" rel="noopener noreferrer">
        <span class="emoji">🎵</span>
        <div class="info">
            <h2>TikTok</h2>
            <p>Os meus vídeos</p>
        </div>
        <span class="arrow">↗</span>
    </a>

    <a class="link"
       href="https://www.youtube.com/@CortesdoMagrelo_YT"
       target="_blank" rel="noopener noreferrer">
        <span class="emoji">▶️</span>
        <div class="info">
            <h2>YouTube</h2>
            <p>Subscreve o canal</p>
        </div>
        <span class="arrow">↗</span>
    </a>
    <footer>
        © 2026 Fonstela · Todas as redes num só lugar
    </footer>

</div>

</body>
</html>
